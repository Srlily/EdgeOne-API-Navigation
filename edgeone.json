{
  "$schema": "./node_modules/@edgeone/sdk/schema.json",
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install",
  "devCommand": "pnpm run dev",
  "routes": [
    {
      "pathname": "/_next/static/:path*",
      "target": "static"
    },
    {
      "pathname": "/api/:path*",
      "target": "serverless"
    },
    {
      "pathname": "/:path*",
      "target": "serverless"
    }
  ]
}
